# Chave do OpenRouter (crie em https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-cole-sua-chave-aqui

# O agente para de chamar a API quando restarem só estas requisições na cota do dia
RESERVA_COTA=5

# Caminho do banco (baixe o cinerocket.db para a pasta data/)
DB_PATH=data/cinerocket.db

# Modelos em ordem de fallback (todos aceitam tool calling)
MODELOS=qwen/qwen3.8-27b:free,nvidia/nemotron-3.5-lightning:free,google/gemma-4-26b-a4b-it:free,openrouter/free
